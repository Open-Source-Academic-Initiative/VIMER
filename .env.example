# Copy to .env and replace every CHANGE_ME value. Never commit .env.
DEPLOYMENT_PROFILE=pilot
DEBUG=False
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS

# Public origin and Django host validation.
VIMER_DOMAIN=vimer.example.org
ALLOWED_HOSTS=vimer.example.org,localhost
CSRF_TRUSTED_ORIGINS=https://vimer.example.org
PUBLIC_BASE_URL=https://vimer.example.org

# Pilot bind mounts. Create these directories before `docker-compose up`.
VIMER_BIND_ADDRESS=127.0.0.1
VIMER_PORT=8000
VIMER_DATA_DIR=./data
VIMER_MEDIA_DIR=./media

# Production PostgreSQL. Passwords embedded in DATABASE_URL must be URL-encoded.
POSTGRES_DB=vimer
POSTGRES_USER=vimer
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://vimer:CHANGE_ME@db:5432/vimer
DATABASE_CONN_MAX_AGE=60

# TLS files consumed by the production Nginx container.
TLS_CERTIFICATE_PATH=./deploy/tls/fullchain.pem
TLS_PRIVATE_KEY_PATH=./deploy/tls/privkey.pem
ACME_CHALLENGE_DIR=./deploy/acme

# Cloudflare Turnstile is fail-closed whenever DEBUG=False.
# Only an isolated maintenance environment may explicitly set this to False
# while also leaving both keys empty. Production never permits the opt-out.
TURNSTILE_REQUIRED=True
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Transactional email.
# Delivery is mandatory whenever DEBUG=False. An isolated maintenance
# environment may explicitly set this to False only with the console backend.
EMAIL_DELIVERY_REQUIRED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CHANGE_ME

# Legal controller data. Values must come from the responsible organization.
SUPPORT_EMAIL=CHANGE_ME
LEGAL_CONTROLLER_NAME=CHANGE_ME
LEGAL_CONTROLLER_ID=CHANGE_ME
LEGAL_CONTROLLER_ADDRESS=CHANGE_ME
LEGAL_CONTROLLER_CONTACT_CHANNEL=CHANGE_ME
PRIVACY_EMAIL=CHANGE_ME
LEGAL_TERMS_VERSION=v1
LEGAL_PRIVACY_VERSION=v1

# Upload and abuse controls.
MARKETPLACE_ATTACHMENT_MAX_COUNT=5
MARKETPLACE_ATTACHMENT_MAX_BYTES=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=57671680
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_NUMBER_FIELDS=200
DATA_UPLOAD_MAX_NUMBER_FILES=10
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_SIGNUP_ATTEMPTS=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=900
RATE_LIMIT_EMAIL_VERIFICATION_ATTEMPTS=20
RATE_LIMIT_EMAIL_VERIFICATION_WINDOW_SECONDS=300

# Runtime.
GUNICORN_WORKERS=3
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
DATABASE_WAIT_ATTEMPTS=30
DATABASE_WAIT_DELAY_SECONDS=2
JOIN_REQUEST_EXPIRY_INTERVAL_SECONDS=300
CHALLENGE_CLOSURE_INTERVAL_SECONDS=900
SCHEDULER_RETRY_DELAY_SECONDS=60
SCHEDULER_HEALTH_GRACE_SECONDS=60
LOG_LEVEL=INFO
